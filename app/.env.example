# --- Firebase client (browser) ---
# Firebase console > Project settings > General > Your apps > SDK setup.
# Deliberately the same project as the other numerico apps (numerico-app):
# Firebase Auth is project-scoped, so a separate project would mean a separate
# account for the same customer. Must match the service account below.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Required for logo upload, and read SERVER-side despite the NEXT_PUBLIC_
# prefix — a bucket name is not a secret, and a second server-only copy of it
# would just be one more thing to forget on a deploy. Looks like
# "your-project.firebasestorage.app" (Firebase console > Storage).
#
# Unset, the app runs normally and only the Branding page's logo upload fails,
# with an error naming this variable. Storage must also be enabled for the
# project — that is a one-time console step, and needs the Blaze plan.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Firebase Admin (server only) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# NEVER prefix these with NEXT_PUBLIC_. Without them adminDb is undefined and
# every API route fails with "Firestore is not configured".
# FIREBASE_PRIVATE_KEY keeps its literal \n escapes, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Names a separate Firestore database for this app's data, giving it its own
# security rules and backups inside the shared project. `marketing` is the
# convention and what firebase.json deploys rules and indexes to. Unset, it
# falls back to (default) alongside numerico-website — the marketing_* collection
# prefixes keep the two apart either way, so blank is a valid first run.
# Customers and entitlements are always read from (default), regardless.
# Verify which database you actually hit with: npx tsx scripts/probe.ts
FIREBASE_DATABASE_ID=marketing

# Optional staff allowlist. Comma-separated Firebase uids and/or emails that are
# admitted regardless of the customer entitlement rail — for numerico's own team.
# Everyone else needs an active `marketing` product on their numerico customer
# record (assigned in the numerico-website CRM). Unset (default) = entitlement is
# the only way in. Compared case-insensitively.
MARKETING_STAFF_UIDS=

# --- LLM ---
# Nothing here. OPENAI_API_KEY, LLM_MODEL and RESEARCH_MODEL used to live in
# this file and now live in the app, under Settings → Model. Sign in as someone
# on MARKETING_STAFF_UIDS and paste the key in; it is stored encrypted with
# GOOGLE_TOKEN_ENC_KEY below and is never shown again.
#
# There is no fallback to an env var, deliberately. A key in two places is a
# key you have to look in two places to rotate. Until one is saved, every model
# call refuses by name and says where to fix it — the app itself boots, signs
# in and renders normally, so you can always reach the page that fixes it.
#
# The model choice moved for its own reason: it was read once at module load,
# so changing it meant a redeploy AND a cold start. Now it takes effect on the
# next call. The list of models offered is LLM_MODELS in
# lib/marketing/llm-settings.ts.

# --- Google Calendar ---
# A SEPARATE OAuth client from numerico-website: this app needs the broader
# .../auth/calendar scope to CREATE a calendar per client (calendar.events can
# only write into calendars that already exist), and escalating the scope on a
# shared client would re-trigger consent for every website user.
#
# In Google Cloud > APIs & Services > Credentials, on the OAuth client:
#   Authorized redirect URI = the GOOGLE_OAUTH_REDIRECT_URI below, exactly.
# The Google Calendar API must also be enabled for the project.
#
# Production needs BOTH URIs listed on the same OAuth client — the localhost one
# below and https://<your-domain>/api/v1/google/callback — and the deployed
# environment sets GOOGLE_OAUTH_REDIRECT_URI to the second. Any difference at
# all, including a trailing slash, and Google answers redirect_uri_mismatch.
#
# Also check APIs & Services > OAuth consent screen: while its publishing status
# is "Testing", Google expires every refresh token after 7 days and only listed
# test users can connect. Calendar sync then works at launch and stops a week
# later. It must be "In production" (or Internal, on a Workspace).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3008/api/v1/google/callback

# Both generated locally, never shared with Google:
#   openssl rand -hex 32
# GOOGLE_TOKEN_ENC_KEY encrypts every secret this app stores at rest
# (AES-256-GCM) — Google refresh tokens AND the OpenAI key under Settings. The
# name is historical; it predates there being a second secret. It has to stay
# in env: you cannot store the key beside the thing it protects, and
# firestore.rules protects nothing the Admin SDK does, so this is the only
# thing between a database dump and a working credential. Rotating it
# invalidates ALL of them at once — everyone must reconnect Google and the
# OpenAI key must be entered again.
# GOOGLE_OAUTH_STATE_SECRET signs the OAuth state, which is what stops the
# callback attaching someone else's Google account to your agency.
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENC_KEY=
