# --- Firebase client (browser) ---
# Firebase console > Project settings > General > Your apps > SDK setup.
# Deliberately the same project as the other numerico apps (numerico-app):
# Firebase Auth is project-scoped, so a separate project would mean a separate
# account for the same customer. Must match the service account below.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# NEVER prefix these with NEXT_PUBLIC_. Without them adminDb is undefined and
# every API route fails with "Firestore is not configured".
# FIREBASE_PRIVATE_KEY keeps its literal \n escapes, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional. Names a separate Firestore database for this app's data, giving it
# its own security rules and backups inside the shared project. Unset, it uses
# (default) alongside numerico-website — the marketing_* collection prefixes
# keep the two apart either way, so leaving this blank is a valid first run.
# Customers and entitlements are always read from (default).
FIREBASE_DATABASE_ID=

# --- LLM ---
# Campaign generation and the schedule planner.
OPENAI_API_KEY=

# --- Google OAuth (Phase 4: Calendar sync) ---
# A SEPARATE OAuth client from numerico-website: this app needs the broader
# .../auth/calendar scope to create a calendar per client, and escalating on a
# shared client would re-trigger consent for website users.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# 32-byte hex key for AES-256-GCM encryption of stored refresh tokens.
GOOGLE_TOKEN_ENC_KEY=
