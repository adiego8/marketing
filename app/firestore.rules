rules_version = '2';

// Deny everything. Nothing in the browser talks to Firestore: lib/firebase.ts
// initialises Auth only, and the client's whole job is minting an ID token that
// API routes verify with the Admin SDK. The Admin SDK bypasses these rules, so
// the strictest possible ruleset costs nothing and is the point of giving this
// app its own database.
//
// If a client-side read is ever added, it belongs behind an API route instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
